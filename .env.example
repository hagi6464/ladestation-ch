# Neon Postgres connection string (use the pooled connection for app, direct for migrations)
# Create a free DB at https://console.neon.tech — copy the connection string from the dashboard
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Shared secret to authorize calls to /api/cron/sync-bfe-*
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET="change-me"
